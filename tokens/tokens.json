{
  "$description": "Single source of truth for the sandbox design system. Figma Variables and the Sass/CSS tokens are both generated from this file.",
  "primitives": {
    "white": "#FFFFFF",
    "gray/50": "#F8FAFC",
    "gray/200": "#E2E8F0",
    "gray/500": "#64748B",
    "gray/900": "#0F172A",
    "blue/50": "#EFF6FF",
    "blue/600": "#2563EB",
    "blue/700": "#1D4ED8",
    "green/50": "#ECFDF5",
    "green/700": "#047857",
    "red/50": "#FEF2F2",
    "red/600": "#DC2626"
  },
  "color": {
    "color/bg/canvas": { "alias": "gray/50", "css": "--ds-color-bg-canvas", "scopes": ["FRAME_FILL"] },
    "color/bg/surface": { "alias": "white", "css": "--ds-color-bg-surface", "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
    "color/bg/brand": { "alias": "blue/600", "css": "--ds-color-bg-brand", "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
    "color/bg/brand-subtle": { "alias": "blue/50", "css": "--ds-color-bg-brand-subtle", "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
    "color/bg/success": { "alias": "green/50", "css": "--ds-color-bg-success", "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
    "color/bg/danger": { "alias": "red/50", "css": "--ds-color-bg-danger", "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
    "color/bg/neutral": { "alias": "gray/200", "css": "--ds-color-bg-neutral", "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
    "color/text/primary": { "alias": "gray/900", "css": "--ds-color-text-primary", "scopes": ["TEXT_FILL"] },
    "color/text/secondary": { "alias": "gray/500", "css": "--ds-color-text-secondary", "scopes": ["TEXT_FILL"] },
    "color/text/on-brand": { "alias": "white", "css": "--ds-color-text-on-brand", "scopes": ["TEXT_FILL"] },
    "color/text/brand": { "alias": "blue/700", "css": "--ds-color-text-brand", "scopes": ["TEXT_FILL"] },
    "color/text/success": { "alias": "green/700", "css": "--ds-color-text-success", "scopes": ["TEXT_FILL"] },
    "color/text/danger": { "alias": "red/600", "css": "--ds-color-text-danger", "scopes": ["TEXT_FILL"] },
    "color/border/default": { "alias": "gray/200", "css": "--ds-color-border-default", "scopes": ["STROKE_COLOR"] },
    "color/border/danger": { "alias": "red/600", "css": "--ds-color-border-danger", "scopes": ["STROKE_COLOR"] }
  },
  "spacing": {
    "spacing/xs": { "value": 4, "css": "--ds-spacing-xs" },
    "spacing/sm": { "value": 8, "css": "--ds-spacing-sm" },
    "spacing/md": { "value": 12, "css": "--ds-spacing-md" },
    "spacing/lg": { "value": 16, "css": "--ds-spacing-lg" },
    "spacing/xl": { "value": 24, "css": "--ds-spacing-xl" },
    "spacing/2xl": { "value": 32, "css": "--ds-spacing-2xl" }
  },
  "radius": {
    "radius/sm": { "value": 6, "css": "--ds-radius-sm" },
    "radius/md": { "value": 8, "css": "--ds-radius-md" },
    "radius/lg": { "value": 12, "css": "--ds-radius-lg" },
    "radius/full": { "value": 999, "css": "--ds-radius-full" }
  },
  "typography": {
    "font-family": "Inter",
    "body/sm": { "size": 13, "lineHeight": 18, "weight": 400 },
    "body/md": { "size": 14, "lineHeight": 20, "weight": 400 },
    "label/md": { "size": 14, "lineHeight": 20, "weight": 500 },
    "heading/md": { "size": 18, "lineHeight": 26, "weight": 600 },
    "heading/lg": { "size": 24, "lineHeight": 32, "weight": 600 }
  }
}
